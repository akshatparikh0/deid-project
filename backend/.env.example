# Copy to .env and fill in for anything other than local development.
# All of these have safe defaults for `./dev.sh` / `python manage.py runserver`.

# A long, random, secret string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# "True" for local development only. Must be "False" in any real deployment.
DJANGO_DEBUG=True

# Comma-separated list of hostnames this server is allowed to answer as.
# Required (non-empty) whenever DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=

# Comma-separated list of extra frontend origins allowed to call the API,
# beyond the localhost:5173 Vite dev origins that are always allowed.
DJANGO_CORS_ALLOWED_ORIGINS=

REDACTION_POLICY_PATH=config/default_policy.json
REDACTION_ENABLE_AI=False
REDACTION_ENABLE_AZURE_LANGUAGE=False
REDACTION_ENABLE_AZURE_OCR=False
REDACTION_FORCE_OCR=False

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_WORKSPACE_ID=

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=

# Async processing (FR-56/FR-57). Empty = every job runs synchronously
# in-process (no extra services needed for local dev). Set to run a real
# out-of-request worker: redis://localhost:6379/0 for local/staging, or
# azureservicebus://<connection-string> in production.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=

# Storage adapters (FR-67 – FR-75). "local" (default, MEDIA_ROOT on disk) |
# "azure_blob" | "s3" | "gcs". Only the block for the selected provider
# needs filling in.
STORAGE_PROVIDER=local

AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=deid-media
# Leave blank in an Azure deployment to authenticate via the container
# app's managed identity (FR-62) instead of a static connection string.
AZURE_STORAGE_CONNECTION_STRING=

AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

GS_BUCKET_NAME=
GCS_PROJECT_ID=

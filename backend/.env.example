# Copy to .env and fill in for anything other than local development.
# All of these have safe defaults for `./dev.sh` / `python manage.py runserver`.

# A long, random, secret string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# "True" for local development only. Must be "False" in any real deployment.
DJANGO_DEBUG=True

# Comma-separated list of hostnames this server is allowed to answer as.
# Required (non-empty) whenever DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=

# Comma-separated list of extra frontend origins allowed to call the API,
# beyond the localhost:5173 Vite dev origins that are always allowed.
DJANGO_CORS_ALLOWED_ORIGINS=
